{
  "name": "@haneoka/cassiopeia-host-web",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/cassiopeia-host-web.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm build && pnpm test:runtime",
    "test:runtime": "node tests/runtime-trace.mjs && node tests/media-clock.mjs",
    "benchmark": "node benchmarks/runtime.mjs"
  },
  "peerDependencies": {
    "@haneoka/cassiopeia": "^0.1.0",
    "@haneoka/cassiopeia-plugin-our-notes": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.14.0",
  "description": "Browser audio and pointer-input host for Cassiopeia"
}
